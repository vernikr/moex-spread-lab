{
  "module_id": "moex-spread-lab.web",
  "release": "0.9.0",
  "contract_version": "msl-web.v1",
  "kind": "web",
  "capabilities": [
    "loopback_http_server",
    "execution_proof_ui",
    "strategy_schema_api",
    "ndjson_progress_streaming",
    "loopback_diagnostics",
    "workstation_daemon_installation"
  ],
  "inputs": [
    "execution-proof.v1",
    "proof-search.v4"
  ],
  "outputs": [
    "strategy-registry.v1",
    "execution-proof.v1",
    "proof-search.v4"
  ],
  "dependencies": [
    "moex-spread-lab.core",
    "moex-spread-lab.proof"
  ],
  "owner": "project-web",
  "resource_profile": {
    "network": "loopback_default_with_explicit_host_origin_opt_in",
    "runtime": "threaded_http_with_proof_managed_workers",
    "storage": "caller-selected"
  },
  "rights_provenance": {
    "data_rights": "private_research_assumption_A-05",
    "credentials": "none",
    "redistribution": "disabled"
  },
  "determinism": {
    "required": true,
    "randomness": "delegated_to_proof"
  },
  "health": {
    "supported_python": ">=3.12,<3.13",
    "status": "active"
  },
  "invariants": [
    "Numerical evaluation and randomness are delegated to ProofService.",
    "Host/Origin checks precede dispatch; diagnostics remain loopback-only.",
    "Static assets are same-origin; diagnostics do not persist research state."
  ],
  "notes": [
    "CLI discovery: moex_spread_lab.web.cli:register.",
    "moex_spread_lab.web exports STATIC_DIR, VENDOR_DIR, ScreenerStore, make_handler, serve and strategy_registry_payload."
  ]
}
